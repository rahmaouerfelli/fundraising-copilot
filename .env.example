# Database — SQLite by default (no setup needed); switch to postgresql://... for production
DATABASE_URL=sqlite:///./data/fundraising_copilot.db

# Qdrant — set to "local" for embedded on-disk storage (no server/Docker needed),
# or run a real server with: docker run -p 6333:6333 qdrant/qdrant
QDRANT_URL=local
QDRANT_COLLECTION=grants

# Mistral AI — https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=ministral-14b-latest
MISTRAL_EMBED_MODEL=mistral-embed

# Tavily — web search for grant discovery, free tier at https://tavily.com (no card required)
TAVILY_API_KEY=your_tavily_api_key_here

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Scheduler
INGESTION_INTERVAL_HOURS=6
REMINDER_CHECK_INTERVAL_HOURS=24

# App
DEBUG=True
